    {
      "parameters": {
        "jsCode": "const validated = $('Validate Draft Inputs').first().json;\nconst rows = $input.all().map(item => item.json).filter(row => row && row.id != null && String(row.status ?? '') === 'pending_approval' && String(row.session_id ?? '') === String(validated.session_id));\nrows.sort((a, b) => Number(b.id) - Number(a.id));\nif (rows.length === 0) {\n  return [{ json: { content: validated.content, session_id: validated.session_id, status: 'pending_approval', draft_id: null, reused_existing: false } }];\n}\nconst match = rows[0];\nreturn [{ json: { content: validated.content, session_id: validated.session_id, status: 'pending_approval', draft_id: Number(match.id), reused_existing: true } }];"
      },
