    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\nconst content = typeof input.content === 'string' ? input.content.trim() : '';\nconst session_id = typeof input.session_id === 'string' ? input.session_id.trim() : '';\nconst rawId = input.draft_id;\n// draft_id 0 is the required-tool sentinel for a brand-new draft.\nconst draft_id = rawId === undefined || rawId === null || rawId === '' || rawId === 0 || rawId === '0' ? null : Number(rawId);\nif (!content) throw new Error('Missing LinkedIn draft content');\nif (!session_id) throw new Error('Missing chat session_id');\nif (content.length > 3000) throw new Error('LinkedIn draft exceeds 3000 characters');\nif (draft_id !== null && (!Number.isFinite(draft_id) || draft_id <= 0)) throw new Error('draft_id must be a positive number when provided');\nreturn [{ json: { content, session_id, status: 'pending_approval', draft_id } }];"
      },
