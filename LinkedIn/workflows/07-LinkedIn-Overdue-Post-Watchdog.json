{
  "name": "07-LinkedIn - Overdue Post Watchdog",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 15
            }
          ]
        }
      },
      "id": "2d778373-27b8-4c9d-a8a0-840b27aa1760",
      "name": "Every 15 minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "operation": "get",
        "dataTableId": {
          "__rl": true,
          "value": "linkedin_posts",
          "mode": "name"
        },
        "returnAll": true
      },
      "id": "15b13c17-1d97-480a-b16b-4570eb54e16a",
      "name": "Get all posts",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        256,
        0
      ],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const now = Date.now();\nconst rows = $input.all().map(i => i.json).filter(r => r && r.id != null);\nconst out = [];\nfor (const r of rows) {\n  const st = String(r.status || '').toLowerCase().trim();\n  const t = Date.parse(String(r.scheduled_at || ''));\n  let reason = null;\n  if (st === 'scheduled' && Number.isFinite(t) && t < now) reason = 'overdue scheduled';\n  else if (st === 'publishing') reason = 'stuck publishing';\n  else if (st === 'failed') reason = 'failed';\n  if (reason) out.push({id: r.id, status: r.status, scheduled_at: r.scheduled_at, published_at: r.published_at, reason});\n}\nif (!out.length) return [];\nconst lines = out.map(o => 'id=' + o.id + ' | status=' + o.status + ' | scheduled_at=' + o.scheduled_at + ' | published_at=' + (o.published_at || '-') + ' | reason: ' + o.reason);\nreturn [{json:{subject:'[n8n] LinkedIn posts need attention (' + out.length + ')', body: lines.join('\\n') + '\\n\\nCheck https://n8n.example.com'}}];"
      },
      "id": "1643ccc1-e6d0-4077-abdb-030ecba83567",
      "name": "Find posts needing attention",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        512,
        0
      ]
    },
    {
      "parameters": {
        "sendTo": "you@example.com",
        "subject": "={{ $json.subject }}",
        "message": "={{ $json.body }}",
        "options": {
          "appendAttribution": false
        }
      },
      "id": "1cc2f48c-3082-4b54-8346-8a001e122b35",
      "name": "Send digest email",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
