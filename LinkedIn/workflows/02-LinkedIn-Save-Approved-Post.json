    {
      "parameters": {
        "jsCode": "const items = $input.all().filter(i => i.json && i.json.id !== undefined);\nconst expected = $('Verify Existing Draft').first().json;\nif (items.length !== 1 || Number(items[0].json.id) !== Number(expected.draft_id) || items[0].json.status !== 'scheduled') {\n  throw new Error('No existing draft row was updated; scheduling is NOT confirmed.');\n}\nreturn [{json:{success:true, draft_id:Number(items[0].json.id), status:'scheduled', scheduled_at:items[0].json.scheduled_at, message:'Existing draft updated; no duplicate row created.'}}];"
      },
