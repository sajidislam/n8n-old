    {
      "parameters": {
        "jsCode": "const p = $input.first().json;\nconst content = String(p.content || '').trim();\nconst timeText = String(p.scheduled_at || '').trim();\nconst message = String(p.approval_message || '').trim();\nconst draft_id = Number(p.draft_id);\nconst isTimeChange = /\\b(reschedule|change(?: the)? (?:publish(?:ing)?|schedule|scheduled|post(?:ing)?) time|update(?: the)? (?:publish(?:ing)?|schedule(?:d)?) time|move (?:it|the post)|publishing time)\\b/i.test(message);\nconst hasApprovalLanguage = /\\b(yes|approve|approved|schedule|go ahead|looks good|publish it|post it|confirm)\\b/i.test(message);\nif (!Number.isFinite(draft_id) || draft_id <= 0) throw new Error('A valid draft_id is required so the existing draft row can be updated. Nothing was inserted.');\nif (!/(Z|[+-]\\d{2}:\\d{2})$/.test(timeText)) throw new Error('scheduled_at must be ISO 8601 with timezone, e.g. 2026-11-07T23:00:00-05:00');\nconst t = Date.parse(timeText);\nif (!Number.isFinite(t) || t <= Date.now() + 15000) throw new Error('Publishing time must be in the future.');\nif (!isTimeChange) {\n  if (p.approved !== true) throw new Error('Cannot schedule: explicit approval is missing.');\n  if (!hasApprovalLanguage) throw new Error('Cannot schedule: the latest user message must explicitly approve or request scheduling of the finalized post.');\n  if (content.length < 5 || content.length > 2900) throw new Error('Post content missing or too long (limit 2900 characters in this template).');\n} else if (content.length > 2900) {\n  throw new Error('Post content is too long (limit 2900 characters in this template).');\n}\nreturn [{ json: { content, scheduled_at: new Date(t).toISOString(), status: 'scheduled', draft_id, approved_at: new Date().toISOString(), isTimeChange, approved: p.approved === true } }];"
      },
