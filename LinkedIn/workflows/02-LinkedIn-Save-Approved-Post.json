    {
      "parameters": {
        "jsCode": "const req = $('Validate approval, text and time').first().json;\nconst rows = $input.all().filter(i => i.json && i.json.id !== undefined).map(i => i.json);\nif (rows.length !== 1) throw new Error('No unique draft found for ID ' + req.draft_id + '. Nothing was scheduled.');\nconst draft = rows[0];\nif (Number(draft.id) !== Number(req.draft_id)) throw new Error('Retrieved draft ID mismatch.');\nconst status = String(draft.status || '').trim().toLowerCase();\nif (status === 'published') throw new Error('This post has already been published, so its schedule cannot be changed.');\nif (status !== 'pending_approval' && status !== 'scheduled') throw new Error('Draft ID ' + req.draft_id + ' cannot be scheduled from status ' + status + '.');\n\nlet content;\nlet approved_at;\nif (status === 'scheduled' || req.isTimeChange) {\n  content = req.content && req.content.length >= 5 ? req.content : String(draft.content || '');\n  if (content.length < 5) throw new Error('Existing post content is missing; nothing was updated.');\n  approved_at = draft.approved_at || req.approved_at;\n} else {\n  if (req.approved !== true) throw new Error('Cannot schedule: explicit approval is missing.');\n  if (!req.content || req.content.length < 5) throw new Error('Post content missing or too long (limit 2900 characters in this template).');\n  if (draft.content !== req.content) throw new Error('Approved text does not exactly match saved draft. Nothing was scheduled.');\n  content = req.content;\n  approved_at = req.approved_at;\n}\nif (Date.parse(req.scheduled_at) <= Date.now() + 15000) throw new Error('Scheduled time is no longer in the future.');\nreturn [{ json: { draft_id: req.draft_id, scheduled_at: req.scheduled_at, approved_at, content, status: 'scheduled' } }];"
      },
